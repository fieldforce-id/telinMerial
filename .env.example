# ==============================================================================
# TEMPLAT KONFIGURASI ENVIRONMENT (TELEGRAM SIGNAL LISTENER & FORWARDER)
# Salin file ini menjadi `.env` dan sesuaikan nilainya.
# Jangan pernah commit file `.env` yang berisi kredensial asli ke Git repository!
# ==============================================================================

# Kredensial API Telegram (Bisa didapatkan dari https://my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH="your_api_hash_here"

# Nama file session Telethon yang akan disimpan di server lokal
TELEGRAM_SESSION_NAME="telin_merial_session"

# Path menuju file konfigurasi YAML (grup sumber dan grup target)
CONFIG_PATH="config.yaml"
